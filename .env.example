# Copy to .env.s25.local (git-ignored) and run `npm run build:s25`.
# Plain `npm run build` / `npm run dev` ignore this file (it is only loaded in --mode s25).
# Every value below is the shipped default.

# 1 = show an FPS / resolution readout (on by default only in `npm run dev`)
VITE_DEBUG_FPS=1
# Multiplier on wild-encounter probability per tall-grass step (0 = none, 2 = double)
VITE_ENCOUNTER_RATE_MULT=1
# Multiplier on the day/night clock speed (2 = twice as fast)
VITE_CLOCK_SPEED_MULT=1
# Wild encounters cycle through these species ids (comma list; empty = normal random pool). Handy for
# reviewing art, e.g. VITE_FORCE_SPECIES=19,25,54 (rat, imp, duck) with VITE_ENCOUNTER_RATE_MULT=50.
VITE_FORCE_SPECIES=
# 1 = open the art gallery (all battle sprites on one screen, tap to flip front/back) instead of the title
VITE_ART_GALLERY=
